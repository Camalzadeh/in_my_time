# Copy to .env.local and fill in. Never commit the filled-in file.
#
# With Docker (`docker compose up`) you do not need MONGODB_URI at all — the
# compose file points the app at its own MongoDB container.

# MongoDB connection string. Atlas: Database > Connect > Drivers.
# MONGO_URI is also still accepted, for older deployments.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority"

# Ably API key, for live poll updates. https://ably.com > App > API keys.
#
# Optional. Without it the site works normally — votes just appear on other
# people's screens when they reload rather than instantly, and the poll header
# says "Offline" instead of "Live".
ABLY_API_KEY=""

# Public origin, used to resolve Open Graph URLs for shared poll links.
# Defaults to https://inmytime.me; set it when running anywhere else.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
