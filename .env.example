# Copy to .env.local and fill in. Never commit the filled-in file.

# MongoDB connection string. Atlas: Database > Connect > Drivers.
# MONGO_URI is also still accepted, for older deployments.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority"

# Ably API key, for realtime poll updates. https://ably.com > App > API keys.
# Without it /api/ably returns 500 and votes only appear after a page reload.
ABLY_API_KEY=""
